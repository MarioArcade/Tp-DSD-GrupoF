type Query {
    historialAlquileres(clienteId: ID!): [HistorialAlquiler!]!
    vehiculosDisponibles(
        fechaInicio: String!
        fechaFin: String!
        tipo: TipoVehiculo
        marca: String
        modelo: String
        precioMinimo: Float
        precioMaximo: Float
    ): [VehiculoDisponible]

    reservas(
        clienteId: ID
        vehiculoId: ID
        tipo: TipoVehiculo
        estado: EstadoReserva
        fechaDesde: String
        fechaHasta: String
    ): [ReservaConsulta!]!
}

type VehiculoDisponible {

    patente: String
    marca: String
    modelo: String
    anio: Int
    color: String
    tipo: TipoVehiculo
    precioDiario: Float
}

enum TipoVehiculo {

    SEDAN
    SUV
    PICKUP
    COUPE
    HATCHBACK
}

enum EstadoReserva {
    CONFIRMADA
    CANCELADA
}

type ReservaConsulta {
    id: ID!
    clienteId: ID!
    nombreCliente: String
    apellidoCliente: String
    vehiculoId: ID!
    patente: String!
    marca: String
    modelo: String
    tipo: TipoVehiculo
    fechaInicio: String!
    fechaFin: String!
    precioDiario: Float!
    importeTotal: Float!
    estado: EstadoReserva!
}

type HistorialAlquiler {
    reservaId: ID!
    patente: String!
    marca: String
    modelo: String
    fechaInicio: String!
    fechaFin: String!
    dias: Int!
    importeTotal: Float!
    estado: EstadoReserva!
}